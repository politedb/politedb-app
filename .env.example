VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_DEBUG=false

# PostHog Project API Key
VITE_POSTHOG_KEY=

# US Cloud: https://us.i.posthog.com
# EU Cloud: https://eu.i.posthog.com
# Self-host: https://your-posthog-domain.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Tauri signing private key
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ---------------------------------------------------------------------------
# Local AI Assistant
# ---------------------------------------------------------------------------
# The app will also look for a downloaded model in:
#   ~/Library/Application Support/<bundle-id>/ai/models/default.gguf

# Override bundled / discovered llama-server path
POLITEDB_LLM_SERVER_BIN=

# Override GGUF model path
POLITEDB_LLM_MODEL_PATH=

# ---------------------------------------------------------------------------
# GitHub Release / CI AI build
# ---------------------------------------------------------------------------
# These are mainly used by .github/workflows/release.yml

# Bundle llama-server into the app
BUNDLE_AI_ASSISTANT=true

# Bundle the GGUF model into the app too.
# Keep this false for smaller production builds.
BUNDLE_AI_MODEL=false

# Hugging Face repo containing the GGUF model
AI_MODEL_REPO=Qwen/Qwen2.5-Coder-7B-Instruct-GGUF

# File glob to download from the repo
AI_MODEL_PATTERN=qwen2.5-coder-7b-instruct-q4_k_m*.gguf

# llama.cpp git ref/tag/branch
AI_LLAMA_REF=master
