{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoliteDB",
  "version": "1.2.3",
  "identifier": "com.politehq.politedb",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 500,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://us.i.posthog.com https://eu.i.posthog.com https://*.posthog.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },

  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Son Pham (JCV2248FMN)",
      "entitlements": "entitlements.mac.plist",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 140
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 140
        }
      }
    },
    "resources": ["resources/ai"],
    "category": "DeveloperTool"
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "process": {
      "relaunch": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERFODhBNENDQUIyOTQ2QTUKUldTbFJpbXJ6S1NJM241b2crd0RraU1EbkRPVmFjY09oY2tCRnVXanAxNG83M1FsVTkxMnY3NzIK",
      "endpoints": ["https://proxy-api.politedb.com"]
    }
  }
}
