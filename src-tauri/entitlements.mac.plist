<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- Required for hardened runtime -->
  <key>com.apple.security.app-sandbox</key>
  <false/>

  <!-- Allow outbound network connections (DB, SSH, APIs) -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- (Optional) If you run a local server / tunnel listener -->
  <!-- Enable ONLY if really needed -->
  <!--
  <key>com.apple.security.network.server</key>
  <true/>
  -->

  <!-- File access: user-selected files/folders only -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>

  <!-- Needed for WebView / Tauri -->
  <key>com.apple.security.cs.allow-jit</key>
  <false/>

  <!-- Allow loading signed dynamic libraries inside app bundle -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <false/>

  <!-- No debugger / no DYLD injection in PROD -->
  <key>com.apple.security.get-task-allow</key>
  <false/>

</dict>
</plist>